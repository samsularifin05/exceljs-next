{
  "name": "exceljs-next",
  "version": "4.5.0",
  "description": "Excel Workbook Manager - Read and Write xlsx and csv Files (Maintained & Security-Hardened Fork of exceljs).",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "Guyon Roche",
    "email": "guyon@live.com"
  },
  "homepage": "https://github.com/samsularifin05/exceljs-next#readme",
  "bugs": {
    "url": "https://github.com/samsularifin05/exceljs-next/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/samsularifin05/exceljs-next.git"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "main": "./excel.js",
  "module": "./excel.mjs",
  "browser": "./dist/exceljs.min.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/exceljs.min.js",
      "import": {
        "types": "./index.d.mts",
        "default": "./excel.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./excel.js"
      },
      "default": "./excel.js"
    },
    "./*": "./*"
  },
  "files": [
    "dist",
    "lib",
    "excel.js",
    "excel.mjs",
    "LICENSE",
    "README.md",
    "README_id.md",
    "README_zh.md",
    "index.ts",
    "index.d.ts",
    "index.d.mts"
  ],
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "test": "pnpm run test:full",
    "test:es5": "export EXCEL_BUILD=es5 && pnpm run test:full",
    "test:full": "pnpm run build && pnpm run test:unit && pnpm run test:integration && pnpm run test:end-to-end && pnpm run test:jasmine",
    "test:version": "pnpm run build && pnpm run test:unit && pnpm run test:integration && pnpm run test:end-to-end && pnpm run test:browser && pnpm run test:dist",
    "test:all": "pnpm run test:native && pnpm run test:es5",
    "test:native": "pnpm run test:full",
    "test:unit": "mocha --require spec/config/setup --require spec/config/setup-unit spec/unit --recursive",
    "test:integration": "mocha --require spec/config/setup spec/integration --recursive",
    "test:end-to-end": "mocha --require spec/config/setup spec/end-to-end --recursive",
    "test:browser": "if [ ! -f .disable-test-browser ]; then pnpm run build && pnpm run test:jasmine; fi",
    "test:jasmine": "grunt jasmine",
    "test:unit:es5": "export EXCEL_BUILD=es5 && pnpm run test:unit",
    "test:integration:es5": "export EXCEL_BUILD=es5 && pnpm run test:integration",
    "test:end-to-end:es5": "export EXCEL_BUILD=es5 && pnpm run test:end-to-end",
    "test:dist": "mocha --require spec/config/setup spec/dist --recursive",
    "test:manual": "node spec/manual/app.js",
    "test:typescript": "mocha -r ts-node/register spec/typescript/**/*.spec.ts",
    "clean-build": "pnpm run clean && pnpm run build",
    "lint": "eslint --format node_modules/eslint-friendly-formatter .",
    "lint:fix": "prettier-eslint --write $(pwd)'/**/*.js'",
    "lint:staged": "lint-staged",
    "clean": "rm -rf build/ && rm -rf dist",
    "benchmark": "node --expose-gc benchmark",
    "benchmark:debug": "node --expose-gc --inspect-brk --trace-deopt benchmark",
    "build": "grunt build",
    "install-build": "pnpm install && grunt build",
    "preversion": "pnpm run clean && pnpm run build && pnpm run test:version",
    "postversion": "git push --no-verify && git push --tags --no-verify"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": [
      "prettier-eslint --write",
      "eslint --format node_modules/eslint-friendly-formatter",
      "git add"
    ]
  },
  "keywords": [
    "xlsx",
    "json",
    "csv",
    "excel",
    "font",
    "border",
    "fill",
    "number",
    "format",
    "number format",
    "alignment",
    "office",
    "spreadsheet",
    "workbook",
    "defined names",
    "data validations",
    "rich text",
    "in-cell format",
    "outlineLevel",
    "views",
    "frozen",
    "split",
    "pageSetup"
  ],
  "dependencies": {
    "archiver": "^5.3.2",
    "dayjs": "^1.11.13",
    "fast-csv": "^4.3.6",
    "jszip": "^3.10.1",
    "readable-stream": "^3.6.2",
    "saxes": "^6.0.0",
    "unzipper": "^0.10.14"
  },
  "devDependencies": {
    "@babel/cli": "^7.10.5",
    "@babel/core": "^7.11.4",
    "@babel/preset-env": "^7.11.0",
    "@types/chai": "^4.2.12",
    "@types/mocha": "^8.0.3",
    "@types/node": "^14.11.2",
    "babelify": "^10.0.0",
    "browserify": "^16.5.2",
    "chai": "^4.2.0",
    "chai-datetime": "^1.7.0",
    "chai-xml": "^0.4.1",
    "core-js": "^3.6.5",
    "dirty-chai": "^2.0.1",
    "eslint": "^6.5.1",
    "eslint-config-airbnb-base": "^14.2.0",
    "eslint-config-prettier": "^6.12.0",
    "eslint-friendly-formatter": "^4.0.1",
    "eslint-plugin-import": "^2.22.0",
    "eslint-plugin-node": "^11.1.0",
    "express": "^4.16.4",
    "got": "^11.8.6",
    "grunt": "^1.3.0",
    "grunt-babel": "^8.0.0",
    "grunt-browserify": "^5.3.0",
    "grunt-contrib-copy": "^1.0.0",
    "grunt-contrib-jasmine": "^2.2.0",
    "grunt-contrib-watch": "^1.1.0",
    "grunt-exorcise": "^2.1.1",
    "grunt-terser": "^1.0.0",
    "husky": "^4.3.0",
    "lint-staged": "^10.2.13",
    "mocha": "^7.2.0",
    "prettier-eslint": "^11.0.0",
    "prettier-eslint-cli": "^5.0.0",
    "regenerator-runtime": "^0.13.7",
    "sax": "^1.2.4",
    "ts-node": "^8.10.2",
    "typescript": "^3.9.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer"
    ],
    "overrides": {
      "braces": "^3.0.3",
      "debug": "^3.2.7",
      "decode-uri-component": "^0.5.1",
      "diff": "^3.5.1",
      "elliptic": "npm:inherits@^2.0.4",
      "flatted": "^3.4.4",
      "http-cache-semantics": "^4.3.0",
      "js-yaml": "^3.15.2",
      "micromatch": "^4.0.8",
      "minimatch": "^3.1.5",
      "minimist": "^1.2.8",
      "puppeteer": "^25.17.0",
      "semver": "^7.8.6",
      "socks": "^2.8.10",
      "tar": "^7.5.23",
      "xml2js": "^0.6.2"
    }
  },
  "overrides": {
    "braces": "^3.0.3",
    "debug": "^3.2.7",
    "decode-uri-component": "^0.5.1",
    "diff": "^3.5.1",
    "elliptic": "npm:inherits@^2.0.4",
    "flatted": "^3.4.4",
    "http-cache-semantics": "^4.3.0",
    "js-yaml": "^3.15.2",
    "micromatch": "^4.0.8",
    "minimatch": "^3.1.5",
    "minimist": "^1.2.8",
    "puppeteer": "^25.17.0",
    "semver": "^7.8.6",
    "socks": "^2.8.10",
    "tar": "^7.5.23",
    "xml2js": "^0.6.2"
  }
}
